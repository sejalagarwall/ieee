double findMaxAverage(int* nums, int len, int k) {
    double sum = 0, avg = 0;
    for(int i=0; i<len; i++) {
        if(i<k) {
            sum += nums[i];
            avg += nums[i];
        }
        else {
            sum -= nums[i-k];
            sum += nums[i];
        }
        if(sum > avg)
            avg = sum;
    }
    return avg/k;
}
